# Скопируйте в .env и замените значения.
# Новый ключ: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DB_NAME=online_store
DB_USER=store_user
DB_PASSWORD=store_pass
DB_HOST=localhost
DB_PORT=5432

# Только для Docker: загрузить демо-товары и создать администратора при старте
LOAD_DEMO_DATA=1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin12345
